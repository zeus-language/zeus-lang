
use raylib;

fn main() : i32 {
    // Initialize the window
    let width : i32 = 800;
    let height :i32= 600;
    InitWindow(width, height, r"Raylib Test with Zeus" as *u8);
    SetTargetFPS(60);               // Set our game to run at 60 frames-per-second
    //--------------------------------------------------------------------------------------
    let mut ballPosition : Vector2 = Vector2 { x: 200.0f, y: 300.0f };
    let ballRadius : float = 45.0f;
    let white   = Color {r : 255 as u8,g : 255 as u8,b : 255  as u8, a : 255  as u8};
    let black : Color = Color {r : 0 as u8,g : 0 as u8,b : 0  as u8, a : 255  as u8};
    let red : Color = Color {r : 255 as u8,g : 0 as u8,b : 0  as u8, a : 255  as u8};
    let green : Color = Color {r : 0 as u8,g : 255 as u8,b : 0  as u8, a : 255  as u8};
    let blue : Color = Color {r : 0 as u8,g : 0 as u8,b : 255  as u8, a : 255  as u8};
    let yellow : Color = Color {r : 255 as u8,g : 255 as u8,b : 0  as u8, a : 255  as u8};

    // Main game loop
    while WindowShouldClose() == false    // Detect window close button or ESC key
    {
        // Draw
        //----------------------------------------------------------------------------------
        BeginDrawing();
        ClearBackground(yellow); // Light gray background
        DrawCircle(150,150, ballRadius , blue);
        DrawText(r"Hello World" as *u8, 190, 200, 20, black);
        EndDrawing();
        //----------------------------------------------------------------------------------
    }


    // Close the window
    CloseWindow();
    return 0;
}