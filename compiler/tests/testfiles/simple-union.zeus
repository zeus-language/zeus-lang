

union Animal {
  Dog(string, double),
  Cat { name: string, weight: double },
}

fn print_animal(animal: Animal) :void{
    match animal {
      Dog(name, weight) => println("Dog:${name}, weight: ${weight}"),
      Cat { name, weight } => println("Cat: ${name}, weight: ${weight}"),
    }
}

fn main() :i32 {
    let dog = Animal::Dog("Fido",12.4);
    let cat = Animal::Cat { name: "Garfield", weight:4.21};
    print_animal(dog);
    print_animal(cat);
    return 0;
}