

union Animal {
  Dog(string, double),
  Cat { name: string, weight: double },
  Undefined,
}

fn print_animal(animal: Animal) :void{
    match animal {
      Animal::Dog(name, weight) => println("Dog: ${name}, weight: ${weight}"),
      Animal::Cat { name, weight } => println("Cat: ${name}, weight: ${weight}"),
      Animal::Undefined => println("Undefined"),
    }
}

fn main() :i32 {
    let dog = Animal::Dog("Fido",12.4);
    let cat = Animal::Cat { name: "Garfield", weight:4.21};
    print_animal(dog);
    print_animal(cat);
    print_animal(Animal::Undefined);
    return 0;
}