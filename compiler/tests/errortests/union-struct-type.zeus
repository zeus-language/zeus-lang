
union TestUnion{
    First{a:string,b:i32},
    Second{x: double}
}

fn main() : i32 {
    let str = string::from_slice("my string");
    let test= TestUnion::First{a: "my string",b: 12};
    let secondarg= TestUnion::First{a: str, b: 12.0};
    let one_arg = TestUnion::First{a: str};
    let second = TestUnion::Second{x: 12};
    return 0;
}