
union TestUnion{
    First(string,i32)
    Second(double)
}

fn main() : i32 {
    let str = string::from_slice("my string");
    let test= TestUnion::First("my string",12);
    let secondarg= TestUnion::First(str,12.0);
    let one_arg = TestUnion::First(str);
    let second = TestUnion::Second(12);
    return 0;
}